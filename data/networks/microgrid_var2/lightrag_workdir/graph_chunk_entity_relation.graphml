    <node id="NL-Busbar_2">
      <data key="d0">NL-Busbar_2</data>
      <data key="d1">location</data>
      <data key="d2">NL-Busbar_2 is a topological node connected to winding 1 of transformer NL_TR2_3.&gt;&lt;SEP&gt;NL-Busbar_2 is a topological node to which winding 2 of transformer NL-TR2_1 is connected.&gt;&lt;SEP&gt;NL-Busbar_2 is a topological node within substation PP_Amsterdam that connects energy consumer NL-Load_3 and breaker B1.</data>
      <data key="d3">doc-be0add59cbaa36750f7e1a8365dca728-chunk-006&lt;SEP&gt;doc-be0add59cbaa36750f7e1a8365dca728-chunk-004&lt;SEP&gt;doc-be0add59cbaa36750f7e1a8365dca728-chunk-008</data>
