      <data key="d6" />
    </node>
    <node id="Winding 1 Of NL-TR2_1">
      <data key="d0">Winding 1 Of NL-TR2_1</data>
      <data key="d1">artifact</data>
      <data key="d2">Winding 1 Of NL-TR2_1 is the first winding of transformer NL-TR2_1, rated at 400 kV and 320 MVA, connected to topological node N1230992195, and equipped with a ratio tap changer.&gt;</data>
      <data key="d3">doc-be0add59cbaa36750f7e1a8365dca728-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1781190013</data>
      <data key="d6" />
    </node>
    <node id="N1230992195">
      <data key="d0">N1230992195</data>
      <data key="d1">artifact</data>
      <data key="d2">N1230992195 is a topological node that serves as one terminal of AC line segments NL-Line_2 and NL-Line_5.&lt;SEP&gt;N1230992195 is a topological node connected to AC line segment NL-Line_1.&gt;&lt;SEP&gt;N1230992195 is a topological node in the network to which energy consumers NL-Load_2 and NL-Load_1 are connected.&lt;SEP&gt;N1230992195 is a topological node to which winding 1 of transformer NL-TR2_1 is connected.&gt;&lt;SEP&gt;N1230992195 is a topological node associated with substation PP_Amsterdam and hosts installations such as linear shunt compensators.</data>
      <data key="d3">doc-be0add59cbaa36750f7e1a8365dca728-chunk-006&lt;SEP&gt;doc-be0add59cbaa36750f7e1a8365dca728-chunk-007&lt;SEP&gt;doc-be0add59cbaa36750f7e1a8365dca728-chunk-002&lt;SEP&gt;doc-be0add59cbaa36750f7e1a8365dca728-chunk-008&lt;SEP&gt;doc-be0add59cbaa36750f7e1a8365dca728-chunk-003</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1781190013</data>
