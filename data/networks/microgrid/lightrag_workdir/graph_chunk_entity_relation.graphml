      <data key="d6" />
    </node>
    <node id="BE-Busbar_4">
      <data key="d0">BE-Busbar_4</data>
      <data key="d1">artifact</data>
      <data key="d2">BE-Busbar_4 is a busbar section installed in voltage level 10.5 of substation PP_Brussels and operates at a nominal voltage of 10.5 kV.&lt;SEP&gt;BE-Busbar_4 is a busbar section installed in voltage level 10.5 of substation PP_Brussels and operating at a nominal voltage of 10.5 kV.&lt;SEP&gt;BE-Busbar_4 is a topological node to which BE-TR2_3 Winding 2 is connected.&lt;SEP&gt;BE-Busbar_4 is a topological node to which synchronous machine BE-G1 is connected.</data>
      <data key="d3">doc-be0add59cbaa36750f7e1a8365dca728-chunk-002&lt;SEP&gt;doc-be0add59cbaa36750f7e1a8365dca728-chunk-006&lt;SEP&gt;doc-be0add59cbaa36750f7e1a8365dca728-chunk-005&lt;SEP&gt;doc-be0add59cbaa36750f7e1a8365dca728-chunk-001</data>
